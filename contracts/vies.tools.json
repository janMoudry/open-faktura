[
  {
    "name": "vies_lookup",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["company_id", "vat_number"],
      "properties": {
        "company_id": {
          "type": "string"
        },
        "vat_number": {
          "type": "string",
          "pattern": "^(AT|BE|BG|HR|CY|CZ|DK|EE|FI|FR|DE|EL|HU|IE|IT|LV|LT|LU|MT|NL|PL|PT|RO|SK|SI|ES|SE|XI)[A-Z0-9+*]{1,20}$"
        }
      }
    }
  }
]
