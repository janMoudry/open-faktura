{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "company_id",
    "calculation_version",
    "currency",
    "tax_mode",
    "price_mode",
    "discount_percent",
    "rounding",
    "lines"
  ],
  "properties": {
    "company_id": {
      "type": "string"
    },
    "calculation_version": {
      "type": "string",
      "enum": ["of-czk-v1"]
    },
    "currency": {
      "type": "string",
      "enum": [
        "CZK",
        "EUR",
        "USD",
        "GBP",
        "CHF",
        "PLN",
        "HUF",
        "JPY",
        "SEK",
        "NOK",
        "DKK",
        "CAD",
        "AUD"
      ]
    },
    "tax_mode": {
      "type": "string",
      "enum": ["non_payer", "vat_payer"]
    },
    "price_mode": {
      "type": "string",
      "enum": ["net", "gross"]
    },
    "discount_percent": {
      "type": "string",
      "maxLength": 24,
      "pattern": "^[0-9]+(?:\\.[0-9]{1,2})?$"
    },
    "rounding": {
      "type": "string",
      "enum": ["none", "whole_czk"]
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "unit",
          "quantity",
          "unit_price",
          "discount_percent",
          "vat_percent"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "unit": {
            "type": "string",
            "maxLength": 30
          },
          "quantity": {
            "type": "string",
            "maxLength": 24,
            "pattern": "^[0-9]+(?:\\.[0-9]{1,4})?$"
          },
          "unit_price": {
            "type": "string",
            "maxLength": 24,
            "pattern": "^[0-9]+(?:\\.[0-9]{1,4})?$"
          },
          "discount_percent": {
            "type": "string",
            "maxLength": 24,
            "pattern": "^[0-9]+(?:\\.[0-9]{1,2})?$"
          },
          "vat_percent": {
            "type": "string",
            "enum": ["0", "12", "21"]
          },
          "catalog_id": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "maxItems": 500
    },
    "exchange_rate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rate", "units"],
      "properties": {
        "rate": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]{1,6})?$"
        },
        "units": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      }
    }
  }
}
