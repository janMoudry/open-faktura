    "/api/companies/{company}/catalog/{id}/line": {
      "get": {
        "operationId": "catalogLine",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "company",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "in": "query",
            "name": "price_mode",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "net",
                "gross"
              ]
            }
          },
          {
            "in": "query",
            "name": "tax_mode",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "non_payer",
                "vat_payer"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceLine"
                }
              }
            }
          },
          "401": {
            "description": "Missing session or invalid origin (fields may be omitted)",
            "content": {
