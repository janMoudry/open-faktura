              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
            "description": "Invalid transport request; framework error body"
          },
          "413": {
            "description": "Invalid transport request; framework error body"
          },
          "415": {
            "description": "Invalid transport request; framework error body"
          }
        }
      },
