  },
  "components": {
    "schemas": {
      "Catalog": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "company_id",
          "revision",
          "archived",
          "data"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 200
          },
          "company_id": {
            "type": "string",
            "maxLength": 200
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "archived": {
            "type": "boolean"
          },
          "data": {
            "$ref": "#/components/schemas/CatalogData"
          }
        }
      },
      "CatalogPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "total",
          "page",
          "page_size"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Catalog"
            }
          },
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "page_size": {
            "type": "integer"
          }
        }
      },
      "CreateCatalog": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "data"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "data": {
            "$ref": "#/components/schemas/CatalogData"
          }
        }
      },
      "UpdateCatalog": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision",
          "archived",
          "data"
        ],
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "archived": {
            "type": "boolean"
          },
          "data": {
            "$ref": "#/components/schemas/CatalogData"
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "unauthorized",
              "not_found",
              "forbidden",
              "invalid_input",
              "revision_conflict",
              "unavailable"
            ]
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CatalogData": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "code",
          "barcode",
          "unit",
          "quantity",
          "unit_price",
          "currency",
          "price_mode",
          "vat_percent"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "code": {
            "type": "string",
            "maxLength": 80
          },
          "barcode": {
            "type": "string",
            "maxLength": 80
          },
          "unit": {
            "type": "string",
            "maxLength": 20
          },
          "quantity": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d{1,4})?$",
            "maxLength": 24
          },
          "unit_price": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d{1,4})?$",
            "maxLength": 24
          },
          "currency": {
            "type": "string",
            "enum": [
              "CZK"
            ]
          },
          "price_mode": {
            "type": "string",
            "enum": [
              "net",
              "gross"
            ]
          },
          "vat_percent": {
            "type": "string",
            "enum": [
              "0",
              "12",
              "21"
            ]
          }
        }
      },
      "InvoiceLine": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "unit",
          "quantity",
          "unit_price",
          "discount_percent",
          "vat_percent"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "unit": {
            "type": "string",
            "maxLength": 30
          },
          "quantity": {
            "type": "string",
            "maxLength": 24,
            "pattern": "^[0-9]+(?:\\.[0-9]{1,4})?$"
          },
          "unit_price": {
            "type": "string",
            "maxLength": 24,
            "pattern": "^[0-9]+(?:\\.[0-9]{1,4})?$"
          },
          "discount_percent": {
            "type": "string",
            "maxLength": 24,
            "pattern": "^[0-9]+(?:\\.[0-9]{1,2})?$"
          },
          "vat_percent": {
            "type": "string",
            "enum": [
              "0",
              "12",
              "21"
            ]
          }
        }
      }
    },
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-faktura_session",
        "description": "Production cookie; development uses faktura_session. 12h absolute lifetime."
      }
    }
  }
}
