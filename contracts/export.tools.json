[
  {
    "name": "register_export",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "language", "columns", "selection", "company_id"],
      "properties": {
        "format": {
          "type": "string",
          "enum": ["csv", "xlsx"]
        },
        "language": {
          "type": "string",
          "enum": ["cs", "en"]
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 14,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "number",
              "description",
              "status",
              "customer",
              "registration_number",
              "issued_on",
              "due_on",
              "currency",
              "net",
              "vat",
              "payable",
              "paid",
              "outstanding",
              "variable_symbol",
              "name",
              "vat_number",
              "email",
              "phone",
              "street",
              "city",
              "postal_code",
              "country",
              "bank_account",
              "iban",
              "archived"
            ]
          }
        },
        "selection": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "search"],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": ["invoices"]
                },
                "search": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "query": {
                      "type": "string"
                    },
                    "page": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 10000
                    },
                    "page_size": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 100
                    },
                    "sort": {
                      "type": "string",
                      "enum": [
                        "updated_desc",
                        "issued_desc",
                        "issued_asc",
                        "customer_asc",
                        "customer_desc",
                        "number_desc",
                        "number_asc",
                        "due_asc",
                        "due_desc",
                        "amount_asc",
                        "amount_desc"
                      ]
                    },
                    "customer_id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "all",
                        "draft",
                        "issued",
                        "outstanding",
                        "overdue",
                        "paid",
                        "partial",
                        "overpaid"
                      ],
                      "default": "all"
                    },
                    "date_field": {
                      "type": "string",
                      "enum": ["issued_on", "due_on"],
                      "default": "issued_on"
                    },
                    "date_from": {
                      "type": "string",
                      "format": "date"
                    },
                    "date_to": {
                      "type": "string",
                      "format": "date"
                    },
                    "amount_min": {
                      "type": "string",
                      "pattern": "^\\d{1,17}(\\.\\d{1,2})?$"
                    },
                    "amount_max": {
                      "type": "string",
                      "pattern": "^\\d{1,17}(\\.\\d{1,2})?$"
                    },
                    "tag_id": {
                      "type": "string",
                      "default": "",
                      "maxLength": 40
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "search"],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": ["contacts"]
                },
                "search": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "query": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "archived": {
                      "type": "boolean",
                      "default": false
                    },
                    "page": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 10000,
                      "default": 1
                    },
                    "page_size": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 100,
                      "default": 25
                    },
                    "tag_id": {
                      "type": "string",
                      "default": "",
                      "maxLength": 40
                    }
                  }
                }
              }
            }
          ]
        },
        "company_id": {
          "type": "string"
        }
      }
    }
  }
]
