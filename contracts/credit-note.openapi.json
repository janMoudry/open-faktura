{
  "openapi": "3.0.3",
  "info": {
    "title": "Open Faktura credit notes",
    "version": "1.0.0"
  },
  "paths": {
    "/api/companies/{company}/credit-notes": {
      "get": {
        "operationId": "credit_list",
        "parameters": [
          {
            "name": "company",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "query",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "invoice_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreditPage"
                }
              }
            }
          },
          "400": {
            "description": "Validation"
          },
          "401": {
            "description": "Session or origin required"
          },
          "403": {
            "description": "Read-only role"
          },
          "404": {
            "description": "Not found in authorized profile"
          },
          "409": {
            "description": "Revision or idempotency conflict"
          },
          "503": {
            "description": "Unavailable"
          }
        }
      },
      "post": {
        "operationId": "credit_create",
        "parameters": [
          {
            "name": "company",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreditDocument"
                }
              }
            }
          },
          "400": {
            "description": "Validation"
          },
          "401": {
            "description": "Session or origin required"
          },
          "403": {
            "description": "Read-only role"
          },
          "404": {
            "description": "Not found in authorized profile"
          },
          "409": {
            "description": "Revision or idempotency conflict"
          },
          "503": {
            "description": "Unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreditCreate"
              }
            }
          }
        }
      }
    },
    "/api/companies/{company}/credit-notes/{id}": {
      "get": {
        "operationId": "credit_get",
        "parameters": [
          {
            "name": "company",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreditDocument"
                }
              }
            }
          },
          "400": {
            "description": "Validation"
          },
          "401": {
            "description": "Session or origin required"
          },
          "403": {
            "description": "Read-only role"
          },
          "404": {
            "description": "Not found in authorized profile"
          },
          "409": {
            "description": "Revision or idempotency conflict"
          },
          "503": {
            "description": "Unavailable"
          }
        }
      },
      "post": {
        "operationId": "credit_command",
        "parameters": [
          {
            "name": "company",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreditDocument"
                }
              }
            }
          },
          "400": {
            "description": "Validation"
          },
          "401": {
            "description": "Session or origin required"
          },
          "403": {
            "description": "Read-only role"
          },
          "404": {
            "description": "Not found in authorized profile"
          },
          "409": {
            "description": "Revision or idempotency conflict"
          },
          "503": {
            "description": "Unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreditCommand"
              }
            }
          }
        }
      }
    },
    "/api/companies/{company}/credit-notes/{id}/pdf": {
      "get": {
        "operationId": "credit_pdf",
        "parameters": [
          {
            "name": "company",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Validation"
          },
          "401": {
            "description": "Session or origin required"
          },
          "403": {
            "description": "Read-only role"
          },
          "404": {
            "description": "Not found in authorized profile"
          },
          "409": {
            "description": "Revision or idempotency conflict"
          },
          "503": {
            "description": "Unavailable"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "InvoiceLine": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "unit",
          "quantity",
          "unit_price",
          "discount_percent",
          "vat_percent"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "unit": {
            "type": "string",
            "maxLength": 30
          },
          "quantity": {
            "type": "string",
            "maxLength": 24,
            "pattern": "^[0-9]+(?:\\.[0-9]{1,4})?$"
          },
          "unit_price": {
            "type": "string",
            "maxLength": 24,
            "pattern": "^[0-9]+(?:\\.[0-9]{1,4})?$"
          },
          "discount_percent": {
            "type": "string",
            "maxLength": 24,
            "pattern": "^[0-9]+(?:\\.[0-9]{1,2})?$"
          },
          "vat_percent": {
            "type": "string",
            "enum": [
              "0",
              "12",
              "21"
            ]
          },
          "catalog_id": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "InvoiceCalculation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "calculation_version",
          "currency",
          "tax_mode",
          "price_mode",
          "discount_percent",
          "rounding",
          "lines"
        ],
        "properties": {
          "calculation_version": {
            "type": "string",
            "enum": [
              "of-czk-v1"
            ]
          },
          "currency": {
            "type": "string",
            "enum": [
              "CZK"
            ]
          },
          "tax_mode": {
            "type": "string",
            "enum": [
              "non_payer",
              "vat_payer"
            ]
          },
          "price_mode": {
            "type": "string",
            "enum": [
              "net",
              "gross"
            ]
          },
          "discount_percent": {
            "type": "string",
            "maxLength": 24,
            "pattern": "^[0-9]+(?:\\.[0-9]{1,2})?$"
          },
          "rounding": {
            "type": "string",
            "enum": [
              "none",
              "whole_czk"
            ]
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InvoiceLine"
            },
            "maxItems": 500
          }
        }
      },
      "InvoiceAmounts": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "net",
          "vat",
          "gross"
        ],
        "properties": {
          "net": {
            "type": "string"
          },
          "vat": {
            "type": "string"
          },
          "gross": {
            "type": "string"
          }
        }
      },
      "InvoiceLineResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "amounts"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "amounts": {
            "$ref": "#/components/schemas/InvoiceAmounts"
          }
        }
      },
      "InvoiceTaxSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tax_mode",
          "vat_percent",
          "amounts"
        ],
        "properties": {
          "tax_mode": {
            "type": "string",
            "enum": [
              "non_payer",
              "vat_payer"
            ]
          },
          "vat_percent": {
            "type": "string",
            "enum": [
              "0",
              "12",
              "21"
            ]
          },
          "amounts": {
            "$ref": "#/components/schemas/InvoiceAmounts"
          }
        }
      },
      "InvoiceTotals": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "calculation_version",
          "currency",
          "lines",
          "tax_summary",
          "amounts",
          "rounding",
          "payable"
        ],
        "properties": {
          "calculation_version": {
            "type": "string",
            "enum": [
              "of-czk-v1",
              "import-v1"
            ]
          },
          "currency": {
            "type": "string",
            "enum": [
              "CZK"
            ]
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InvoiceLineResult"
            }
          },
          "tax_summary": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InvoiceTaxSummary"
            }
          },
          "amounts": {
            "$ref": "#/components/schemas/InvoiceAmounts"
          },
          "rounding": {
            "type": "string"
          },
          "payable": {
            "type": "string"
          }
        }
      },
      "InvoiceError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "fields"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "DraftAddress": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "street",
          "city",
          "postal_code",
          "country"
        ],
        "properties": {
          "street": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "postal_code": {
            "type": "string"
          },
          "country": {
            "type": "string"
          }
        }
      },
      "PartySnapshot": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "registration_number",
          "vat_number",
          "email",
          "phone",
          "address"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "registration_number": {
            "type": "string"
          },
          "vat_number": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "address": {
            "$ref": "#/components/schemas/DraftAddress"
          }
        }
      },
      "PaymentSnapshot": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bank_account",
          "iban",
          "variable_symbol",
          "method"
        ],
        "properties": {
          "bank_account": {
            "type": "string"
          },
          "iban": {
            "type": "string"
          },
          "variable_symbol": {
            "type": "string"
          },
          "method": {
            "type": "string",
            "enum": [
              "cash",
              "bank_transfer"
            ]
          }
        }
      },
      "DraftData": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contact_id",
          "supplier",
          "customer",
          "payment",
          "calculation",
          "issued_on",
          "due_on",
          "tax_on",
          "language",
          "order_number",
          "note"
        ],
        "properties": {
          "contact_id": {
            "type": "string",
            "nullable": true
          },
          "supplier": {
            "$ref": "#/components/schemas/PartySnapshot"
          },
          "customer": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PartySnapshot"
              }
            ],
            "nullable": true
          },
          "payment": {
            "$ref": "#/components/schemas/PaymentSnapshot"
          },
          "calculation": {
            "$ref": "#/components/schemas/DraftCalculation"
          },
          "issued_on": {
            "type": "string",
            "nullable": true,
            "format": "date"
          },
          "due_on": {
            "type": "string",
            "nullable": true,
            "format": "date"
          },
          "tax_on": {
            "type": "string",
            "nullable": true,
            "format": "date"
          },
          "language": {
            "type": "string",
            "enum": [
              "cs",
              "en"
            ]
          },
          "order_number": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      },
      "DraftLine": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "unit",
          "quantity",
          "unit_price",
          "discount_percent",
          "vat_percent"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "unit": {
            "type": "string",
            "maxLength": 30
          },
          "quantity": {
            "type": "string",
            "maxLength": 24
          },
          "unit_price": {
            "type": "string",
            "maxLength": 24
          },
          "discount_percent": {
            "type": "string",
            "maxLength": 24
          },
          "vat_percent": {
            "type": "string",
            "enum": [
              "0",
              "12",
              "21"
            ]
          },
          "catalog_id": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "DraftCalculation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "calculation_version",
          "currency",
          "tax_mode",
          "price_mode",
          "discount_percent",
          "rounding",
          "lines"
        ],
        "properties": {
          "calculation_version": {
            "type": "string",
            "enum": [
              "of-czk-v1",
              "import-v1"
            ]
          },
          "currency": {
            "type": "string",
            "enum": [
              "CZK"
            ]
          },
          "tax_mode": {
            "type": "string",
            "enum": [
              "non_payer",
              "vat_payer"
            ]
          },
          "price_mode": {
            "type": "string",
            "enum": [
              "net",
              "gross"
            ]
          },
          "discount_percent": {
            "type": "string"
          },
          "rounding": {
            "type": "string",
            "enum": [
              "none",
              "whole_czk"
            ]
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DraftLine"
            },
            "maxItems": 500
          }
        }
      },
      "Draft": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "company_id",
          "revision",
          "data",
          "totals",
          "number",
          "issued_at",
          "settlement",
          "advances"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "company_id": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "data": {
            "$ref": "#/components/schemas/DraftData"
          },
          "totals": {
            "allOf": [
              {
                "$ref": "#/components/schemas/InvoiceTotals"
              }
            ],
            "nullable": true
          },
          "number": {
            "type": "string",
            "nullable": true
          },
          "issued_at": {
            "type": "string",
            "nullable": true
          },
          "settlement": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Settlement"
              }
            ],
            "nullable": true
          },
          "advances": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AdvanceSettlement"
              }
            ],
            "nullable": true
          }
        }
      },
      "DraftPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "total",
          "page",
          "page_size"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Draft"
            }
          },
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "page_size": {
            "type": "integer"
          }
        }
      },
      "CreateDraft": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "data"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "data": {
            "$ref": "#/components/schemas/DraftData"
          }
        }
      },
      "UpdateDraft": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision",
          "data"
        ],
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "data": {
            "$ref": "#/components/schemas/DraftData"
          }
        }
      },
      "IssueInvoice": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "revision"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "Settlement": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "paid",
          "outstanding",
          "overpayment",
          "status",
          "overdue",
          "revision",
          "today"
        ],
        "properties": {
          "paid": {
            "type": "string",
            "pattern": "^\\d+\\.\\d{2}$"
          },
          "outstanding": {
            "type": "string",
            "pattern": "^\\d+\\.\\d{2}$"
          },
          "overpayment": {
            "type": "string",
            "pattern": "^\\d+\\.\\d{2}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "unpaid",
              "partial",
              "paid",
              "overpaid"
            ]
          },
          "overdue": {
            "type": "boolean"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "today": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "PaymentInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "amount",
          "paid_on",
          "method",
          "note"
        ],
        "properties": {
          "amount": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d{1,2})?$"
          },
          "paid_on": {
            "type": "string",
            "format": "date"
          },
          "method": {
            "type": "string",
            "enum": [
              "cash",
              "bank_transfer"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 500
          }
        }
      },
      "Payment": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "amount",
          "paid_on",
          "method",
          "note",
          "actor_id",
          "created_at",
          "reversed_at",
          "reason",
          "reversed_by",
          "replacement_id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "amount": {
            "type": "string",
            "pattern": "^\\d+\\.\\d{2}$"
          },
          "paid_on": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "actor_id": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "reversed_at": {
            "type": "string",
            "nullable": true
          },
          "reason": {
            "type": "string",
            "nullable": true
          },
          "reversed_by": {
            "type": "string",
            "nullable": true
          },
          "replacement_id": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Payments": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "summary",
          "items"
        ],
        "properties": {
          "summary": {
            "$ref": "#/components/schemas/Settlement"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Payment"
            }
          }
        }
      },
      "RegisterPayment": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "revision",
          "payment"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "payment": {
            "$ref": "#/components/schemas/PaymentInput"
          }
        }
      },
