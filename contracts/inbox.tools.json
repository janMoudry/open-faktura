        "company_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "required": ["company_id", "id"],
      "additionalProperties": false
    }
  },
  {
    "name": "inbox_extract",
    "inputSchema": {
      "type": "object",
      "properties": {
        "company_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "required": ["company_id", "id"],
      "additionalProperties": false
    }
  },
  {
    "name": "inbox_history",
    "inputSchema": {
      "type": "object",
      "properties": {
        "company_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "required": ["company_id", "id"],
      "additionalProperties": false
    }
  },
  {
    "name": "inbox_settings",
    "inputSchema": {
      "type": "object",
      "properties": {
        "company_id": {
          "type": "string"
        }
      },
      "required": ["company_id"],
      "additionalProperties": false
    }
  },
  {
    "name": "inbox_configure",
    "inputSchema": {
      "type": "object",
      "properties": {
        "company_id": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "email_enabled": {
          "type": "boolean"
        },
        "extraction_provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "company_id",
        "revision",
        "email_enabled",
        "extraction_provider"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "inbox_mail_history",
    "inputSchema": {
      "type": "object",
      "properties": {
        "company_id": {
          "type": "string"
        }
      },
      "required": ["company_id"],
      "additionalProperties": false
    }
  },
  {
    "name": "inbox_mail",
    "inputSchema": {
      "type": "object",
      "properties": {
        "company_id": {
          "type": "string"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "message_id": {
          "type": "string",
          "maxLength": 998
        },
        "sender": {
          "type": "string",
          "maxLength": 320
        },
        "subject": {
          "type": "string",
          "maxLength": 998
        },
        "attachments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": ["request_id", "filename", "base64"],
            "additionalProperties": false,
            "properties": {
              "request_id": {
                "type": "string"
              },
              "filename": {
                "type": "string"
              },
              "base64": {
                "type": "string"
              }
            }
          }
        }
      },
      "required": [
        "company_id",
        "request_id",
        "message_id",
        "sender",
        "subject",
        "attachments"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "inbox_extract_provider",
    "inputSchema": {
      "type": "object",
      "properties": {
        "company_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "required": ["company_id", "id"],
      "additionalProperties": false
    }
  }
]
