[
  {
    "name": "tax_receipt_list",
    "inputSchema": {
      "type": "object",
      "properties": {
        "company_id": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "page_size": {
          "type": "integer",
          "enum": [
            10,
            25,
            50,
            100
          ]
        }
      },
      "required": [
        "company_id"
      ],
      "additionalProperties": false
    }
  },
  {
