    "inputSchema": {
      "type": "object",
      "properties": {
        "company_id": {
          "type": "string"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "advance_id": {
          "type": "string"
        },
        "payment_id": {
          "type": "string"
        },
        "issued_on": {
          "type": "string",
