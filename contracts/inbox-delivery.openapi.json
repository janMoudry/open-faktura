{
  "openapi": "3.0.3",
  "info": {
    "title": "Explicit inbox original delivery",
    "version": "1.0.0",
    "description": "Original-file-only SMTP outbox. confirm_original must be true. No public share links or generated accounting PDFs. 400 validation,401 session,403 role,404 inaccessible source,409 revision/replay conflict."
  },
  "paths": {
    "/api/companies/{company}/inbox/{id}/deliveries": {
      "get": {
        "operationId": "inbox_delivery_history",
        "description": "Authenticated profile access. Send is an external action requiring explicit authorization to deliver the named original attachment to the supplied recipient. UUID replay does not queue twice; uncertain SMTP attempts are never automatically retried.",
        "parameters": [
          {
            "name": "company",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Snapshot queue result or latest 50 delivery history. sent means SMTP acceptance, not recipient delivery.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InboxDeliveryHistory"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "inbox_delivery_send",
        "description": "Authenticated profile access. Send is an external action requiring explicit authorization to deliver the named original attachment to the supplied recipient. UUID replay does not queue twice; uncertain SMTP attempts are never automatically retried.",
        "parameters": [
          {
            "name": "company",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Snapshot queue result or latest 50 delivery history. sent means SMTP acceptance, not recipient delivery.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InboxDelivery"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InboxSendOriginal"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "InboxSendOriginal": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "request_id": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "format": "int64"
          },
          "recipient": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "confirm_original": {
            "type": "boolean"
          }
        },
        "required": [
          "request_id",
          "revision",
          "recipient",
          "subject",
          "body",
          "confirm_original"
        ]
      },
      "InboxDelivery": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "document_id": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "format": "int64"
          },
          "recipient": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "format": "int64"
          },
          "sender": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["queued", "sending", "sent", "failed", "uncertain"]
          },
          "error_code": {
            "type": "string",
            "nullable": true
          },
          "created_at": {
            "type": "string"
          },
          "finished_at": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "document_id",
          "revision",
          "recipient",
          "subject",
          "body",
          "filename",
          "sha256",
          "size",
          "sender",
          "status",
          "error_code",
          "created_at",
          "finished_at"
        ]
      },
      "InboxDeliveryHistory": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "configured": {
            "type": "boolean"
          },
          "sender": {
            "type": "string",
            "nullable": true
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InboxDelivery"
            }
          }
        },
        "required": ["configured", "sender", "items"]
      }
    }
  }
}
