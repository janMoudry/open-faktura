  {
    "name": "received_expenses",
    "inputSchema": {
      "type": "object",
      "properties": {
        "company_id": {
          "type": "string"
        },
        "from": {
          "type": "string",
          "format": "date"
        },
        "to": {
          "type": "string",
          "format": "date"
        },
        "query": {
          "type": "string"
        },
        "method": {
          "type": "string",
          "enum": ["all", "cash", "card", "bank_transfer"]
        },
        "status": {
          "type": "string",
          "enum": ["active", "reversed", "all"]
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      },
      "required": ["company_id", "from", "to"],
      "additionalProperties": false
