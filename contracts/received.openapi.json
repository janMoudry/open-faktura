    "/api/companies/{company}/received-invoices/preview": {
      "post": {
        "operationId": "received_preview",
        "parameters": [
          {
            "name": "company",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
