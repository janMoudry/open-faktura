{
  "openapi": "3.1.0",
  "info": {
    "title": "Open Faktura register export",
    "version": "1.0.0"
  },
  "paths": {
    "/api/companies/{company_id}/exports": {
      "post": {
        "operationId": "registerExport",
        "description": "Read-only filtered export; max 10000 rows. Validated pagination is ignored. Text cells preserve precision. Session and same-origin header required.",
        "parameters": [
          {
            "name": "company_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExportRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Download with Content-Disposition, no-store and nosniff",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Malformed JSON"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Origin rejected"
          },
          "404": {
            "description": "Profile not accessible"
          },
          "413": {
            "description": "Request too large"
          },
          "422": {
            "description": "Invalid columns, selection or export_limit"
          },
          "503": {
            "description": "Unavailable"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "InvoicesSearch": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string"
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "sort": {
            "type": "string",
            "enum": [
              "updated_desc",
              "issued_desc",
              "issued_asc",
              "customer_asc",
              "customer_desc",
              "number_desc",
              "number_asc",
              "due_asc",
              "due_desc",
              "amount_asc",
              "amount_desc"
            ]
          },
          "customer_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "all",
              "draft",
              "issued",
              "outstanding",
              "overdue",
              "paid",
              "partial",
              "overpaid"
            ],
            "default": "all"
          },
          "date_field": {
            "type": "string",
            "enum": ["issued_on", "due_on"],
            "default": "issued_on"
          },
          "date_from": {
            "type": "string",
            "format": "date"
          },
          "date_to": {
            "type": "string",
            "format": "date"
          },
          "amount_min": {
            "type": "string",
            "pattern": "^\\d{1,17}(\\.\\d{1,2})?$"
          },
          "amount_max": {
            "type": "string",
            "pattern": "^\\d{1,17}(\\.\\d{1,2})?$"
          },
          "tag_id": {
            "type": "string",
            "default": "",
            "maxLength": 40
          }
        }
      },
      "InvoicesSelection": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "search"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["invoices"]
          },
          "search": {
            "$ref": "#/components/schemas/InvoicesSearch"
          }
        }
      },
      "ContactsSearch": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 200
          },
          "archived": {
            "type": "boolean",
            "default": false
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000,
            "default": 1
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 25
          },
          "tag_id": {
            "type": "string",
            "default": "",
            "maxLength": 40
          }
        }
      },
      "ContactsSelection": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "search"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["contacts"]
          },
          "search": {
            "$ref": "#/components/schemas/ContactsSearch"
          }
        }
      },
      "ExportRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["format", "language", "columns", "selection"],
        "properties": {
          "format": {
            "type": "string",
            "enum": ["csv", "xlsx"]
          },
          "language": {
            "type": "string",
            "enum": ["cs", "en"]
          },
          "columns": {
            "type": "array",
            "minItems": 1,
            "maxItems": 14,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "number",
                "description",
                "status",
                "customer",
                "registration_number",
                "issued_on",
                "due_on",
                "currency",
                "net",
                "vat",
                "payable",
                "paid",
                "outstanding",
                "variable_symbol",
                "name",
                "vat_number",
                "email",
                "phone",
                "street",
                "city",
                "postal_code",
                "country",
                "bank_account",
                "iban",
                "archived"
              ]
            }
          },
          "selection": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/InvoicesSelection"
              },
              {
                "$ref": "#/components/schemas/ContactsSelection"
              }
            ]
          }
        }
      }
    }
  }
}
