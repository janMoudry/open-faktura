  "components": {
    "schemas": {
      "CashAccountData": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "currency": {
            "type": "string",
            "enum": ["CZK"]
          },
          "opening_on": {
            "type": "string",
            "format": "date"
          },
          "opening_balance": {
            "type": "string"
          }
        },
        "required": ["name", "currency", "opening_on", "opening_balance"]
      },
      "CashAccount": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "format": "int64"
          },
          "data": {
            "$ref": "#/components/schemas/CashAccountData"
          },
          "archived": {
            "type": "boolean"
          }
        },
        "required": ["id", "revision", "data", "archived"]
      },
      "CashMovementData": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "booked_on": {
            "type": "string",
            "format": "date"
          },
          "amount": {
            "type": "string"
          },
          "currency": {
            "type": "string",
            "enum": ["CZK"]
          },
          "variable_symbol": {
            "type": "string"
          },
          "counterparty": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "person": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "booked_on",
          "amount",
          "currency",
          "variable_symbol",
          "counterparty",
          "description",
          "person"
        ]
      },
      "CashMatch": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "target_kind": {
            "type": "string",
            "enum": ["invoice", "received", "advance", "credit"]
          },
          "document_kind": {
            "type": "string",
            "enum": ["invoice", "receipt", "advance", "credit"]
          },
          "document_id": {
            "type": "string"
          },
          "document_number": {
            "type": "string"
          },
          "payment_id": {
            "type": "string"
          },
          "created_payment": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string"
          },
          "actor_id": {
            "type": "string"
          },
          "detached_at": {
            "type": "string",
            "nullable": true
          },
          "detached_by": {
            "type": "string",
            "nullable": true
          },
          "reason": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "target_kind",
          "document_kind",
          "document_id",
          "document_number",
          "payment_id",
          "created_payment",
          "created_at",
          "actor_id",
          "detached_at",
          "detached_by",
          "reason"
        ]
      },
      "CashMovement": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "account_id": {
            "type": "string"
          },
          "number": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "format": "int64"
          },
          "data": {
            "$ref": "#/components/schemas/CashMovementData"
          },
          "matches": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CashMatch"
            }
          },
          "cancelled": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "nullable": true
          },
          "automatic": {
            "type": "boolean"
          },
          "tax": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CashTaxSnapshot"
              }
            ],
            "nullable": true
          },
          "retail_posting_id": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "account_id",
          "number",
          "revision",
          "data",
          "matches",
          "cancelled",
          "reason",
          "automatic",
          "tax"
        ]
      },
      "CashPage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CashMovement"
            }
          },
          "total": {
            "type": "integer",
            "format": "int64"
          },
          "page": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": ["items", "total", "page"]
      },
      "CashCandidate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "target_kind": {
            "type": "string",
            "enum": ["invoice", "received", "advance", "credit"]
          },
          "document_kind": {
            "type": "string",
            "enum": ["invoice", "receipt", "advance", "credit"]
          },
          "document_id": {
            "type": "string"
          },
          "number": {
            "type": "string"
          },
          "partner": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "format": "int64"
          },
          "payment_id": {
            "type": "string",
            "nullable": true
          },
          "outstanding": {
            "type": "string"
          },
          "available": {
            "type": "string"
          }
        },
        "required": [
          "target_kind",
          "document_kind",
          "document_id",
          "number",
          "partner",
          "revision",
          "payment_id",
          "outstanding",
          "available"
        ]
      },
      "CashCommand": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "request_id": {
                "type": "string",
                "format": "uuid"
              },
              "action": {
                "type": "string",
                "enum": ["account"]
              },
              "id": {
                "type": "string",
                "nullable": true
              },
              "revision": {
                "type": "integer",
                "format": "int64",
                "nullable": true
              },
              "data": {
                "$ref": "#/components/schemas/CashAccountData"
              },
              "archived": {
                "type": "boolean"
              }
            },
            "required": [
              "request_id",
              "action",
              "id",
              "revision",
              "data",
              "archived"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "request_id": {
                "type": "string",
                "format": "uuid"
              },
              "action": {
                "type": "string",
                "enum": ["manual"]
              },
              "account_id": {
                "type": "string"
              },
              "data": {
                "$ref": "#/components/schemas/CashMovementData"
              }
            },
            "required": ["request_id", "action", "account_id", "data"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "request_id": {
                "type": "string",
                "format": "uuid"
              },
              "action": {
                "type": "string",
                "enum": ["match"]
              },
              "movement_id": {
                "type": "string"
              },
              "revision": {
                "type": "integer",
                "format": "int64"
              },
              "target_kind": {
                "type": "string",
                "enum": ["invoice", "received", "advance", "credit"]
              },
              "document_id": {
                "type": "string"
              },
              "target_revision": {
                "type": "integer",
                "format": "int64"
              },
              "payment_id": {
                "type": "string",
                "nullable": true
              }
            },
            "required": [
              "request_id",
              "action",
              "movement_id",
              "revision",
              "target_kind",
              "document_id",
              "target_revision",
              "payment_id"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "request_id": {
                "type": "string",
                "format": "uuid"
              },
              "action": {
                "type": "string",
                "enum": ["unmatch"]
              },
              "movement_id": {
                "type": "string"
              },
              "revision": {
                "type": "integer",
                "format": "int64"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "request_id",
              "action",
              "movement_id",
              "revision",
              "reason"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "request_id": {
                "type": "string",
                "format": "uuid"
              },
              "action": {
                "type": "string",
                "enum": ["cancel"]
              },
              "movement_id": {
                "type": "string"
              },
              "revision": {
                "type": "integer",
                "format": "int64"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "request_id",
              "action",
              "movement_id",
              "revision",
              "reason"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["request_id", "action", "account_id", "revision"],
            "properties": {
              "request_id": {
                "type": "string",
                "format": "uuid"
              },
              "action": {
                "type": "string",
                "enum": ["settings"]
              },
              "account_id": {
                "type": "string",
                "nullable": true
              },
              "revision": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "request_id": {
                "type": "string",
                "format": "uuid"
              },
              "action": {
                "type": "string",
                "enum": ["tax_manual"]
              },
              "account_id": {
                "type": "string"
              },
              "data": {
                "$ref": "#/components/schemas/CashMovementData"
              },
              "tax": {
                "$ref": "#/components/schemas/CashTaxInput"
              }
            },
            "required": ["request_id", "action", "account_id", "data", "tax"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "revision",
              "code",
