{
  "openapi": "3.0.3",
  "info": {
    "title": "Personal preferences",
    "version": "1.0.0"
  },
  "paths": {
    "/api/auth/preferences": {
      "get": {
        "operationId": "preferences_get",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Preferences"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "preferences_set",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Preferences"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Preferences"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Preferences": {
        "type": "object",
        "required": ["revision", "theme"],
        "additionalProperties": false,
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 0
