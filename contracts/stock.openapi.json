          },
          "quantity": {
            "type": "string"
          },
          "unit_cost": {
            "type": "string",
            "nullable": true
          },
          "value": {
            "type": "string",
            "nullable": true
          },
          "cost_revision": {
            "type": "integer"
          },
          "issued_value": {
            "type": [
              "string",
              "null"
            ]
          },
          "correction_stock_value": {
            "type": [
              "string",
              "null"
            ]
          },
          "correction_issued_value": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "StockReport": {
        "type": "object",
        "additionalProperties": false,
        "required": [
