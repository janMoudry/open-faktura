        "required": [
          "catalog_id",
          "revision",
          "effective_on",
          "unit_cost",
          "reason",
          "request_id"
        ],
        "properties": {
          "catalog_id": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "effective_on": {
            "type": "string",
            "format": "date"
          },
          "unit_cost": {
            "type": "string",
            "nullable": true
          },
          "reason": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "StockReportItem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "catalog_id",
          "name",
          "code",
          "unit",
          "archived",
          "quantity",
          "unit_cost",
          "value",
          "cost_revision",
          "issued_value",
          "correction_stock_value",
          "correction_issued_value"
