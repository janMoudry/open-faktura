{
  "openapi": "3.0.3",
  "info": {
    "title": "Open Faktura explicit EPO taxpayer metadata",
    "version": "1.0.0"
  },
  "paths": {
    "/api/companies/{company}/reports/tax/filing-profile": {
      "get": {
        "operationId": "taxpayer_filing_profile_get",
        "parameters": [
          {
            "name": "company",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Explicit taxpayer metadata; not a filing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "401": {
            "description": "No session"
          },
          "403": {
            "description": "No company access"
          },
          "409": {
            "description": "Revision or replay conflict"
          },
          "422": {
            "description": "Invalid metadata"
          }
        }
      },
      "post": {
        "operationId": "taxpayer_filing_profile_set",
        "parameters": [
          {
            "name": "company",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Explicit taxpayer metadata; not a filing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "401": {
            "description": "No session"
          },
          "403": {
            "description": "No company access"
          },
          "409": {
            "description": "Revision or replay conflict"
          },
          "422": {
            "description": "Invalid metadata"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Command"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Data": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tax_office",
          "tax_office_workplace",
          "taxpayer_number",
          "taxpayer_kind",
          "vat_filer_kind"
        ],
        "properties": {
          "tax_office": {
            "type": "string",
            "pattern": "[0-9]{1,3}"
          },
          "tax_office_workplace": {
            "type": "string",
            "nullable": true,
            "pattern": "[0-9]{1,4}"
          },
          "taxpayer_number": {
            "type": "string",
            "pattern": "[0-9]{1,10}"
          },
          "taxpayer_kind": {
            "type": "string",
            "enum": [
              "F",
              "P"
            ]
          },
          "vat_filer_kind": {
            "type": "string",
            "enum": [
              "P",
              "I",
              "S",
              "N",
              "R",
              "D"
            ]
          }
        }
      },
      "Command": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "revision",
          "data"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "data": {
            "$ref": "#/components/schemas/Data"
          }
        }
      },
      "Profile": {
        "type": "object",
        "required": [
          "revision",
          "data"
        ],
        "properties": {
          "revision": {
            "type": "integer",
            "format": "int64"
          },
          "data": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Data"
              }
            ],
            "nullable": true
          }
        }
      }
    }
  }
}
