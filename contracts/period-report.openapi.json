{
  "openapi": "3.0.3",
  "info": {
    "title": "Period report",
    "version": "1.1.0"
  },
  "paths": {
    "/api/companies/{company}/reports/period": {
      "get": {
        "operationId": "period_report",
        "parameters": [
          {
            "name": "company",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          },
          {
            "name": "value_mode",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "gross",
                "net"
              ],
              "default": "gross"
            }
          },
          {
            "name": "cumulative",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "compare_previous",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "grouping",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "month",
                "quarter",
                "year"
              ],
              "default": "month"
            },
            "description": "Calendar grouping; max inclusive range 367 days (month), 1097 (quarter), 3654 (year). Partial buckets include only the requested dates."
          }
        ],
        "responses": {
          "200": {
            "description": "CZK document values, not cash flow",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PeriodReport"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Forbidden"
          },
          "422": {
            "description": "Invalid period"
          },
          "503": {
            "description": "Unavailable"
          }
        }
      }
    },
    "/api/companies/{company}/reports/dashboard": {
      "get": {
        "operationId": "dashboard_report",
        "parameters": [
          {
            "name": "company",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "year",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1900,
              "maximum": 9999
            }
          },
          {
            "name": "all_years",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current CZK settlement dashboard; selected year balances, all-time top partners.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Dashboard"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Forbidden"
          },
          "422": {
            "description": "Invalid year"
          },
          "503": {
            "description": "Unavailable"
          }
        }
      }
    },
    "/api/companies/{company}/reports/tax": {
      "get": {
        "operationId": "tax_report",
        "parameters": [
          {
            "name": "company",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "year",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1900
            }
          },
          {
            "name": "quarterly",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "turnover_sources",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current CZK settlement dashboard; selected year balances, all-time top partners.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaxReport"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Forbidden"
          },
          "422": {
            "description": "Invalid year"
          },
          "503": {
            "description": "Unavailable"
          }
        }
      }
    },
    "/api/companies/{company}/reports/tax/export": {
      "post": {
        "operationId": "tax_evidence_export",
        "parameters": [
          {
            "name": "company",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaxExportRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Read-only VAT/turnover evidence, all sources within 10000 rows, not a tax filing",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "No membership"
          },
          "422": {
            "description": "Invalid period or export limit"
          },
          "503": {
            "description": "Unavailable"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ReportEntry": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "number",
          "reported_on",
          "amount",
          "side"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "number": {
            "type": "string"
          },
          "reported_on": {
            "type": "string"
          },
          "amount": {
            "type": "string"
          },
          "side": {
            "type": "string"
          }
        }
      },
      "ReportMonth": {
        "type": "object",
        "required": [
          "month",
          "sales",
          "purchases"
        ],
        "properties": {
          "month": {
            "type": "string",
            "description": "Legacy field name: YYYY-MM for month, YYYY-Q1..Q4 for quarter, YYYY for year."
          },
          "sales": {
            "type": "string"
          },
          "purchases": {
            "type": "string"
          }
        }
      },
      "PeriodReport": {
        "type": "object",
        "required": [
          "sales",
          "purchases",
          "currency",
          "total",
          "page",
          "items",
          "months",
          "comparison",
          "grouping"
        ],
        "properties": {
          "sales": {
            "type": "string"
          },
          "purchases": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReportEntry"
            }
          },
          "months": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReportMonth"
            }
          },
          "comparison": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ReportComparison"
              }
            ],
            "nullable": true
          },
          "grouping": {
            "type": "string",
            "enum": [
              "month",
              "quarter",
              "year"
            ],
            "default": "month"
          }
        }
      },
      "ReportComparison": {
        "type": "object",
        "required": [
          "from",
          "to",
          "sales",
          "purchases",
          "sales_difference",
          "purchases_difference",
          "months"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "sales": {
            "type": "string"
          },
          "purchases": {
            "type": "string"
          },
          "sales_difference": {
            "type": "string"
          },
          "purchases_difference": {
            "type": "string"
          },
          "months": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReportMonth"
            }
          }
        }
      },
      "Balance": {
        "type": "object",
        "required": [
          "gross",
          "net",
          "settled",
          "outstanding"
        ],
        "properties": {
          "gross": {
            "type": "string"
          },
          "net": {
            "type": "string"
          },
          "settled": {
            "type": "string"
          },
          "outstanding": {
            "type": "string"
          }
        }
      },
      "DashboardAge": {
        "type": "object",
        "required": [
          "side",
          "bucket",
          "amount",
          "count"
        ],
        "properties": {
          "side": {
            "type": "string"
          },
          "bucket": {
            "type": "string"
          },
          "amount": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          }
        }
      },
      "DashboardPartner": {
        "type": "object",
        "required": [
          "contact_id",
          "name",
          "amount",
          "count"
        ],
        "properties": {
          "contact_id": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "type": "string"
          },
          "amount": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          }
        }
      },
      "Dashboard": {
        "type": "object",
        "required": [
          "today",
          "year",
          "sales",
          "purchases",
          "aging",
          "customers",
          "debtors"
        ],
        "properties": {
          "today": {
            "type": "string"
          },
          "year": {
            "type": "integer"
          },
          "sales": {
            "$ref": "#/components/schemas/Balance"
          },
          "purchases": {
            "$ref": "#/components/schemas/Balance"
          },
          "aging": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DashboardAge"
            }
          },
          "customers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DashboardPartner"
            }
          },
          "debtors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DashboardPartner"
            }
          }
        }
      },
      "TaxPeriod": {
        "type": "object",
        "required": [
          "period",
          "output",
          "input",
          "difference"
        ],
        "properties": {
          "period": {
            "type": "string"
          },
          "output": {
            "type": "string"
          },
          "input": {
            "type": "string"
          },
          "difference": {
            "type": "string"
          }
        }
      },
      "TaxEntry": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "number",
          "amount",
          "side",
          "reported_on"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "description": "Source kind: invoice, credit_note, tax_receipt, retail, received, purchase_receipt or cash (standalone taxable cash movement)."
          },
          "number": {
            "type": "string"
          },
          "amount": {
            "type": "string"
          },
          "side": {
            "type": "string"
          },
          "reported_on": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "TaxReport": {
        "type": "object",
        "required": [
          "tax_mode",
          "turnover",
          "output",
          "input",
          "difference",
          "year",
          "page",
          "total",
          "periods",
          "items"
        ],
        "properties": {
          "tax_mode": {
            "type": "string"
          },
          "turnover": {
            "type": "string"
          },
          "output": {
            "type": "string"
          },
          "input": {
            "type": "string"
          },
          "difference": {
            "type": "string"
          },
          "year": {
            "type": "integer",
            "format": "int64"
          },
          "page": {
            "type": "integer",
            "format": "int64"
          },
          "total": {
            "type": "integer",
            "format": "int64"
          },
          "periods": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaxPeriod"
            }
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaxEntry"
            }
          }
        }
      },
      "TaxExportRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "search",
          "format",
          "language"
        ],
        "properties": {
          "search": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "year": {
                "type": "integer",
                "minimum": 1900
              },
              "quarterly": {
                "type": "boolean",
                "default": false
              },
              "turnover_sources": {
                "type": "boolean",
                "default": false
              },
              "page": {
                "type": "integer",
                "description": "Ignored for export; all matching sources are included within the export limit."
              }
            }
          },
          "format": {
            "type": "string",
            "enum": [
              "csv",
              "xlsx"
            ]
          },
          "language": {
            "type": "string",
            "enum": [
              "cs",
              "en"
            ]
          }
        }
      }
    }
  }
}
