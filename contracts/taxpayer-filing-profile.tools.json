[
  {
    "name": "taxpayer_filing_profile_get",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "company_id": {
          "type": "string"
        }
      },
      "required": ["company_id"]
    }
  },
  {
    "name": "taxpayer_filing_profile_set",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "company_id": {
          "type": "string"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tax_office",
            "tax_office_workplace",
            "taxpayer_number",
            "taxpayer_kind",
            "vat_filer_kind"
          ],
          "properties": {
            "tax_office": {
              "type": "string",
              "pattern": "[0-9]{1,3}"
            },
            "tax_office_workplace": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "[0-9]{1,4}"
                },
                {
                  "type": "null"
                }
              ]
            },
            "taxpayer_number": {
              "type": "string",
              "pattern": "[0-9]{1,10}"
            },
            "taxpayer_kind": {
              "type": "string",
              "enum": ["F", "P"]
            },
            "vat_filer_kind": {
              "type": "string",
              "enum": ["P", "I", "S", "N", "R", "D"]
            }
          }
        }
      },
      "required": ["company_id", "request_id", "revision", "data"]
    }
  }
]
