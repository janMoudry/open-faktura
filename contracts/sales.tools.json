      "type": "object",
      "properties": {
        "company_id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": ["template", "quote", "advance"]
        },
        "query": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "all",
            "created",
            "sent",
            "ordered",
            "invoiced",
            "rejected",
            "paid",
            "outstanding",
            "overdue"
          ]
        },
        "archived": {
          "type": "boolean"
        },
        "page": {
          "type": "integer"
        },
        "page_size": {
          "type": "integer"
        },
        "tag_id": {
          "type": "string",
          "default": "",
          "maxLength": 40
        }
      },
      "required": ["company_id"],
      "additionalProperties": false
    }
  },
  {
    "name": "sales_create",
    "inputSchema": {
      "type": "object",
      "properties": {
        "company_id": {
          "type": "string"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "type": "string",
          "enum": ["template", "quote", "advance"]
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "maturity_days": {
              "type": "integer",
              "minimum": 0,
              "maximum": 365
            },
            "status": {
              "type": "string",
              "enum": ["created", "sent", "ordered", "invoiced", "rejected"]
            },
            "invoice": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "contact_id",
                "supplier",
                "customer",
                "payment",
                "calculation",
                "issued_on",
                "due_on",
                "tax_on",
                "language",
                "order_number",
                "note"
              ],
              "properties": {
                "contact_id": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "supplier": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "registration_number",
                    "vat_number",
                    "email",
                    "phone",
                    "address"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "registration_number": {
                      "type": "string"
                    },
                    "vat_number": {
                      "type": "string"
                    },
                    "email": {
                      "type": "string"
                    },
                    "phone": {
                      "type": "string"
                    },
                    "address": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["street", "city", "postal_code", "country"],
                      "properties": {
                        "street": {
                          "type": "string"
                        },
                        "city": {
                          "type": "string"
                        },
                        "postal_code": {
                          "type": "string"
                        },
                        "country": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "customer": {
                  "anyOf": [
                    {
                      "allOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "name",
                            "registration_number",
                            "vat_number",
                            "email",
                            "phone",
                            "address"
                          ],
                          "properties": {
                            "name": {
                              "type": "string"
                            },
                            "registration_number": {
                              "type": "string"
                            },
                            "vat_number": {
                              "type": "string"
                            },
                            "email": {
                              "type": "string"
                            },
                            "phone": {
                              "type": "string"
                            },
                            "address": {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "street",
                                "city",
                                "postal_code",
                                "country"
                              ],
                              "properties": {
                                "street": {
                                  "type": "string"
                                },
                                "city": {
                                  "type": "string"
                                },
                                "postal_code": {
                                  "type": "string"
                                },
                                "country": {
                                  "type": "string"
                                }
                              }
                            }
                          }
                        }
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "payment": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "bank_account",
                    "iban",
                    "variable_symbol",
                    "method"
                  ],
                  "properties": {
                    "bank_account": {
                      "type": "string"
                    },
                    "iban": {
                      "type": "string"
                    },
                    "variable_symbol": {
                      "type": "string"
                    },
                    "method": {
                      "type": "string",
                      "enum": ["cash", "bank_transfer"]
                    }
                  }
                },
                "calculation": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "calculation_version",
                    "currency",
                    "tax_mode",
                    "price_mode",
                    "discount_percent",
                    "rounding",
                    "lines"
                  ],
                  "properties": {
                    "calculation_version": {
                      "type": "string",
                      "enum": ["of-czk-v1", "import-v1"]
                    },
                    "currency": {
                      "type": "string",
                      "enum": [
                        "CZK",
                        "EUR",
                        "USD",
                        "GBP",
                        "CHF",
                        "PLN",
                        "HUF",
                        "JPY",
                        "SEK",
                        "NOK",
                        "DKK",
                        "CAD",
                        "AUD"
                      ]
                    },
                    "tax_mode": {
                      "type": "string",
                      "enum": ["non_payer", "vat_payer"]
                    },
                    "price_mode": {
                      "type": "string",
                      "enum": ["net", "gross"]
                    },
                    "discount_percent": {
                      "type": "string"
                    },
                    "rounding": {
                      "type": "string",
                      "enum": ["none", "whole_czk"]
                    },
                    "lines": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "id",
                          "description",
                          "unit",
                          "quantity",
                          "unit_price",
                          "discount_percent",
                          "vat_percent"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64
                          },
                          "description": {
                            "type": "string",
                            "maxLength": 2000
                          },
                          "unit": {
                            "type": "string",
                            "maxLength": 30
                          },
                          "quantity": {
                            "type": "string",
                            "maxLength": 24
                          },
                          "unit_price": {
                            "type": "string",
                            "maxLength": 24
                          },
                          "discount_percent": {
                            "type": "string",
                            "maxLength": 24
                          },
                          "vat_percent": {
                            "type": "string",
                            "enum": ["0", "12", "21"]
                          },
                          "catalog_id": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        }
                      },
                      "maxItems": 500
                    },
                    "exchange_rate": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["rate", "units"],
                      "properties": {
                        "rate": {
                          "type": "string",
                          "pattern": "^[0-9]+(\\.[0-9]{1,6})?$"
                        },
                        "units": {
                          "type": "string",
                          "pattern": "^[0-9]+$"
                        }
                      }
                    }
                  }
                },
                "issued_on": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "due_on": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "tax_on": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "language": {
                  "type": "string",
                  "enum": ["cs", "en"]
                },
                "order_number": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                },
                "qr_format": {
                  "type": "string",
                  "enum": ["payment", "invoice", "payment_invoice"],
                  "description": "Immutable print choice; omitted means legacy QR payment. Invoice formats support ordinary CZK invoices from 2024; unsupported data produce no QR."
                }
              }
            }
          },
          "required": ["name", "maturity_days", "status", "invoice"]
        }
      },
      "required": ["company_id", "request_id", "kind", "data"],
      "additionalProperties": false
    }
  },
