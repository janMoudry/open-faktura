{
  "openapi": "3.0.3",
  "info": {
    "title": "Open Faktura advance payments and PDF",
    "version": "1.0.0"
  },
  "paths": {
    "/api/companies/{company}/advances/{id}/pdf": {
      "get": {
        "operationId": "advancePdf",
        "parameters": [
          {
            "name": "company",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Scoped advance operation; no-store",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Revision or idempotency conflict"
          },
          "422": {
            "description": "Invalid command"
          },
          "503": {
            "description": "Unavailable"
          }
        }
      }
    },
    "/api/companies/{company}/advances/{id}/payments": {
      "get": {
        "operationId": "advancePayments",
        "parameters": [
          {
            "name": "company",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Scoped advance operation; no-store",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Receipt"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Revision or idempotency conflict"
          },
          "422": {
            "description": "Invalid command"
          },
          "503": {
            "description": "Unavailable"
          }
        }
      },
      "post": {
        "operationId": "advanceRegister",
        "parameters": [
          {
            "name": "company",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Scoped advance operation; no-store",
            "content": {
              "application/json": {
                "schema": {
                  "type": "null"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Revision or idempotency conflict"
          },
          "422": {
            "description": "Invalid command"
          },
          "503": {
            "description": "Unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Register"
              }
            }
          }
        }
      }
    },
    "/api/companies/{company}/advances/{id}/payments/{payment}/reverse": {
      "post": {
        "operationId": "advanceReverse",
        "parameters": [
          {
            "name": "company",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "payment",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Scoped advance operation; no-store",
            "content": {
              "application/json": {
                "schema": {
                  "type": "null"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Revision or idempotency conflict"
          },
          "422": {
            "description": "Invalid command"
          },
          "503": {
            "description": "Unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Reverse"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Register": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "revision",
          "payment"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "payment": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "amount",
              "paid_on",
              "method",
              "note"
            ],
            "properties": {
              "amount": {
                "type": "string",
                "pattern": "^\\d+(\\.\\d{1,2})?$"
              },
              "paid_on": {
                "type": "string",
                "format": "date"
              },
              "method": {
                "type": "string",
                "enum": [
                  "cash",
                  "bank_transfer"
                ]
              },
              "note": {
                "type": "string",
                "maxLength": 500
              }
            }
          }
        }
      },
      "Reverse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision",
          "reason"
        ],
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "Receipt": {
        "type": "object",
        "required": [
          "id",
          "amount",
          "paid_on",
          "method",
          "note",
          "reversed",
          "reason",
          "tax_receipt_id",
          "tax_receipt_number"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "amount": {
            "type": "string"
          },
          "paid_on": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "reversed": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "nullable": true
          },
          "tax_receipt_id": {
            "type": "string",
            "nullable": true
          },
          "tax_receipt_number": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  }
}
