[
  {
    "name": "catalog_line",
    "inputSchema": {
      "type": "object",
      "properties": {
        "company_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "price_mode": {
          "type": "string",
          "enum": [
            "net",
            "gross"
          ]
        },
        "tax_mode": {
          "type": "string",
          "enum": [
            "non_payer",
            "vat_payer"
          ]
        }
      },
      "required": [
        "company_id",
        "id",
        "price_mode",
        "tax_mode"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "catalogs_list",
    "inputSchema": {
      "type": "object",
      "properties": {
        "company_id": {
          "type": "string"
        },
        "query": {
          "type": "string",
          "maxLength": 200
        },
        "archived": {
          "type": "boolean",
          "default": false
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "default": 1
        },
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25
        }
      },
      "required": [
        "company_id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "catalog_get",
    "inputSchema": {
      "type": "object",
      "properties": {
        "company_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "company_id",
        "id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "catalog_create",
    "inputSchema": {
      "type": "object",
      "properties": {
        "company_id": {
          "type": "string"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "code",
            "barcode",
            "unit",
            "quantity",
            "unit_price",
            "currency",
            "price_mode",
            "vat_percent"
          ],
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 200,
              "minLength": 1
            },
            "code": {
              "type": "string",
              "maxLength": 80
            },
            "barcode": {
              "type": "string",
              "maxLength": 80
            },
            "unit": {
              "type": "string",
              "maxLength": 20
            },
            "quantity": {
              "type": "string",
              "pattern": "^\\d+(\\.\\d{1,4})?$",
              "maxLength": 24
            },
            "unit_price": {
              "type": "string",
              "pattern": "^\\d+(\\.\\d{1,4})?$",
              "maxLength": 24
            },
            "currency": {
              "type": "string",
              "enum": [
                "CZK"
              ]
            },
            "price_mode": {
              "type": "string",
              "enum": [
                "net",
                "gross"
              ]
            },
            "vat_percent": {
              "type": "string",
              "enum": [
                "0",
                "12",
                "21"
              ]
            }
          }
        }
      },
      "required": [
        "company_id",
        "request_id",
        "data"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "catalog_update",
    "inputSchema": {
      "type": "object",
      "properties": {
        "company_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "archived": {
          "type": "boolean"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "code",
            "barcode",
            "unit",
            "quantity",
            "unit_price",
            "currency",
            "price_mode",
            "vat_percent"
          ],
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 200,
              "minLength": 1
            },
            "code": {
              "type": "string",
              "maxLength": 80
            },
            "barcode": {
              "type": "string",
              "maxLength": 80
            },
            "unit": {
              "type": "string",
              "maxLength": 20
            },
            "quantity": {
              "type": "string",
              "pattern": "^\\d+(\\.\\d{1,4})?$",
              "maxLength": 24
            },
            "unit_price": {
              "type": "string",
              "pattern": "^\\d+(\\.\\d{1,4})?$",
              "maxLength": 24
            },
            "currency": {
              "type": "string",
              "enum": [
                "CZK"
              ]
            },
            "price_mode": {
              "type": "string",
              "enum": [
                "net",
                "gross"
              ]
            },
            "vat_percent": {
              "type": "string",
              "enum": [
                "0",
                "12",
                "21"
              ]
            }
          }
        }
      },
      "required": [
        "company_id",
        "id",
        "revision",
        "archived",
        "data"
      ],
      "additionalProperties": false
    }
  }
]
