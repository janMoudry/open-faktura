{
  "openapi": "3.1.0",
  "info": {
    "title": "Reversible trash for unlinked unpublished quotations and templates",
    "version": "1.0.0"
  },
  "paths": {
    "/api/companies/{company}/sales-trash": {
      "parameters": [
        {
          "name": "company",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "operationId": "sales_trash_list",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient role"
          },
          "404": {
            "description": "Not found or inaccessible profile"
          },
          "409": {
            "description": "Revision, state or protected document conflict"
          }
        }
      },
      "post": {
        "operationId": "sales_trash_execute",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Command"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Entry"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient role"
          },
          "404": {
            "description": "Not found or inaccessible profile"
          },
          "409": {
            "description": "Revision, state or protected document conflict"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Command": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "id", "revision", "action"],
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "id": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "action": {
            "type": "string",
            "enum": ["trash", "restore"]
          }
        }
      },
      "Entry": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "customer",
          "revision",
          "deleted_at",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "customer": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "format": "int64"
          },
          "deleted_at": {
            "type": ["string", "null"]
          },
          "kind": {
            "type": "string",
            "enum": ["quote", "template"]
          }
        }
      },
      "Page": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items", "total", "page", "page_size"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Entry"
            }
          },
          "total": {
            "type": "integer",
            "format": "int64"
          },
          "page": {
            "type": "integer",
            "format": "int64"
          },
          "page_size": {
            "type": "integer",
            "format": "int64"
          }
        }
      }
    }
  }
}
