[
  {
    "name": "period_report",
    "inputSchema": {
      "type": "object",
      "properties": {
        "company_id": {
          "type": "string"
        },
        "from": {
          "type": "string",
          "format": "date"
        },
        "to": {
          "type": "string",
          "format": "date"
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "value_mode": {
          "type": "string",
          "enum": [
            "gross",
            "net"
          ],
          "default": "gross"
        },
        "cumulative": {
          "type": "boolean",
          "default": false
        },
        "compare_previous": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "company_id",
        "from",
        "to"
      ],
      "additionalProperties": false
    }
  }
]
