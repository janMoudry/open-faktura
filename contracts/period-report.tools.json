[
  {
    "name": "period_report",
    "inputSchema": {
      "type": "object",
      "properties": {
        "company_id": {
          "type": "string"
        },
        "from": {
          "type": "string",
          "format": "date"
        },
        "to": {
          "type": "string",
          "format": "date"
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "value_mode": {
          "type": "string",
          "enum": ["gross", "net"],
          "default": "gross"
        },
        "cumulative": {
          "type": "boolean",
          "default": false
        },
        "compare_previous": {
          "type": "boolean",
          "default": false
        },
        "grouping": {
          "type": "string",
          "enum": ["month", "quarter", "year"],
          "default": "month"
        }
      },
      "required": ["company_id", "from", "to"],
      "additionalProperties": false
    }
  },
  {
    "name": "dashboard_report",
    "inputSchema": {
      "type": "object",
      "properties": {
        "company_id": {
          "type": "string"
        },
        "year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 9999
        },
        "all_years": {
          "type": "boolean",
          "default": false
        }
      },
      "required": ["company_id"],
      "additionalProperties": false
    }
  },
  {
    "name": "tax_report",
    "inputSchema": {
      "type": "object",
      "properties": {
        "company_id": {
          "type": "string"
        },
        "year": {
          "type": "integer",
          "minimum": 1900
        },
        "quarterly": {
          "type": "boolean",
          "default": false
        },
        "turnover_sources": {
          "type": "boolean",
          "default": false
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      },
      "required": ["company_id"],
      "additionalProperties": false
    }
  },
  {
    "name": "tax_evidence_export",
    "inputSchema": {
      "type": "object",
      "properties": {
        "company_id": {
          "type": "string"
        },
        "search": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "year": {
              "type": "integer",
              "minimum": 1900
            },
            "quarterly": {
              "type": "boolean",
              "default": false
            },
            "turnover_sources": {
              "type": "boolean",
              "default": false
            },
            "page": {
              "type": "integer",
              "description": "Ignored for export; all matching sources are included within the export limit."
            }
          }
        },
        "format": {
          "type": "string",
          "enum": ["csv", "xlsx"]
        },
        "language": {
          "type": "string",
          "enum": ["cs", "en"]
        }
      },
      "required": ["company_id", "search", "format", "language"],
      "additionalProperties": false
    }
  }
]
