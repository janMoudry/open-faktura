          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateShare"
              }
            }
          }
        }
      }
    },
    "/api/companies/{company}/invoices/{id}/shares/{share}/revoke": {
      "post": {
        "operationId": "invoiceShareRevoke",
        "parameters": [
          {
            "name": "company",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "share",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
