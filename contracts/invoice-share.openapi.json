  "components": {
    "schemas": {
      "CreateShare": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "format": "int64"
          },
          "expires_days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 365
          }
        },
        "required": [
          "request_id",
          "revision",
          "expires_days"
        ]
      },
      "ShareLink": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "expires_at": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "format": "int64"
          },
          "revoked_at": {
            "type": "string",
            "nullable": true
          },
          "view_count": {
            "type": "integer",
            "format": "int64"
          },
          "first_viewed_at": {
            "type": "string",
            "nullable": true
          },
          "last_viewed_at": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "url",
          "created_at",
          "expires_at",
          "revision",
          "revoked_at",
          "view_count",
          "first_viewed_at",
          "last_viewed_at"
        ]
      },
      "ShareLinks": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "configured": {
            "type": "boolean"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ShareLink"
            }
          },
          "page": {
            "type": "integer",
            "format": "int64"
          },
          "total": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "configured",
          "items",
          "page",
          "total"
        ]
      },
      "ShareViews": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "revision": {
                  "type": "integer",
                  "format": "int64"
                },
                "viewed_at": {
                  "type": "string"
                }
              },
              "required": [
                "revision",
                "viewed_at"
              ]
            }
          },
          "page": {
            "type": "integer",
            "format": "int64"
          },
          "total": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "items",
          "page",
          "total"
        ]
      }
    }
  }
}
