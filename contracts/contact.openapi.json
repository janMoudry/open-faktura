{
  "openapi": "3.0.3",
  "info": {
    "title": "Open Faktura profile contact directory",
    "version": "0.1.0"
  },
  "paths": {
    "/api/companies/{company}/contacts": {
      "get": {
        "operationId": "listContacts",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "company",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "in": "query",
            "name": "query",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "in": "query",
            "name": "archived",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "default": 1
            }
          },
          {
            "in": "query",
            "name": "page_size",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "tag_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "maxLength": 40
            },
            "description": "Filter assigned company tag before pagination; empty means all."
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactPage"
                }
              }
            }
          },
          "401": {
            "description": "Missing session or invalid origin (fields may be omitted)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Read-only membership",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Profile or contact inaccessible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Revision or request key conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
            "description": "Invalid transport request; framework error body"
          },
          "413": {
            "description": "Invalid transport request; framework error body"
          },
          "415": {
            "description": "Invalid transport request; framework error body"
          }
        }
      },
      "post": {
        "operationId": "createContact",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "company",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Faktura-Request",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Contact"
                }
              }
            }
          },
          "401": {
            "description": "Missing session or invalid origin (fields may be omitted)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Read-only membership",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Profile or contact inaccessible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Revision or request key conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
            "description": "Invalid transport request; framework error body"
          },
          "413": {
            "description": "Invalid transport request; framework error body"
          },
          "415": {
            "description": "Invalid transport request; framework error body"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateContact"
              }
            }
          }
        }
      }
    },
    "/api/companies/{company}/contacts/{id}": {
      "get": {
        "operationId": "getContact",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "company",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Contact"
                }
              }
            }
          },
          "401": {
            "description": "Missing session or invalid origin (fields may be omitted)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Read-only membership",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Profile or contact inaccessible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Revision or request key conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
            "description": "Invalid transport request; framework error body"
          },
          "413": {
            "description": "Invalid transport request; framework error body"
          },
          "415": {
            "description": "Invalid transport request; framework error body"
          }
        }
      },
      "put": {
        "operationId": "updateContact",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "company",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Faktura-Request",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Contact"
                }
              }
            }
          },
          "401": {
            "description": "Missing session or invalid origin (fields may be omitted)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Read-only membership",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Profile or contact inaccessible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Revision or request key conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
            "description": "Invalid transport request; framework error body"
          },
          "413": {
            "description": "Invalid transport request; framework error body"
          },
          "415": {
            "description": "Invalid transport request; framework error body"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateContact"
              }
            }
          }
        }
      }
    },
    "/api/companies/{company}/contacts/ares/{ico}": {
      "get": {
        "operationId": "lookupContactAres",
        "parameters": [
          {
            "name": "company",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ico",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{8}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Registry proposal, not saved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistryContact"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Profile or entity not found"
          },
          "422": {
            "description": "Invalid ICO"
          },
          "503": {
            "description": "Registry unavailable or busy"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Address": {
        "type": "object",
        "additionalProperties": false,
        "required": ["street", "city", "postal_code", "country"],
        "properties": {
          "street": {
            "type": "string",
            "maxLength": 200
          },
          "city": {
            "type": "string",
            "maxLength": 120
          },
          "postal_code": {
            "type": "string",
            "maxLength": 30
          },
          "country": {
            "type": "string",
            "maxLength": 2
          }
        }
      },
      "DeliveryAddress": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "address"],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64
          },
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "address": {
            "$ref": "#/components/schemas/Address"
          }
        }
      },
      "Person": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "email", "phone"],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "maxLength": 254
          },
          "phone": {
            "type": "string",
            "maxLength": 50
          }
        }
      },
      "ContactData": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "registration_number",
          "vat_number",
          "billing_address",
          "delivery_addresses",
          "default_delivery_id",
          "email",
          "phone",
          "persons",
          "recipients",
          "maturity_days",
          "payment_method",
          "bank_account",
          "iban",
          "note"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "registration_number": {
            "type": "string",
            "maxLength": 32
          },
          "vat_number": {
            "type": "string",
            "maxLength": 32
          },
          "billing_address": {
            "$ref": "#/components/schemas/Address"
          },
          "delivery_addresses": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/DeliveryAddress"
            }
          },
          "default_delivery_id": {
            "type": "string",
            "maxLength": 64,
            "nullable": true
          },
          "email": {
            "type": "string",
            "maxLength": 254
          },
          "phone": {
            "type": "string",
            "maxLength": 50
          },
          "persons": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/Person"
            }
          },
          "recipients": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "maxLength": 254
            }
          },
          "maturity_days": {
            "type": "integer",
            "minimum": 0,
            "maximum": 365,
            "nullable": true
          },
          "payment_method": {
            "type": "string",
            "enum": ["", "cash", "bank_transfer"]
          },
          "bank_account": {
            "type": "string",
            "maxLength": 80
          },
          "iban": {
            "type": "string",
            "maxLength": 34
          },
          "note": {
            "type": "string",
            "maxLength": 2000
          }
        }
      },
      "Contact": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "company_id", "revision", "archived", "data"],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 200
          },
          "company_id": {
            "type": "string",
            "maxLength": 200
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "archived": {
            "type": "boolean"
          },
          "data": {
            "$ref": "#/components/schemas/ContactData"
          }
        }
      },
      "ContactPage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items", "total", "page", "page_size"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Contact"
            }
          },
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "page_size": {
            "type": "integer"
          }
        }
      },
      "CreateContact": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "data"],
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "data": {
            "$ref": "#/components/schemas/ContactData"
          }
        }
      },
      "UpdateContact": {
        "type": "object",
        "additionalProperties": false,
        "required": ["revision", "archived", "data"],
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "archived": {
            "type": "boolean"
          },
          "data": {
            "$ref": "#/components/schemas/ContactData"
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code"],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "unauthorized",
              "not_found",
              "forbidden",
              "invalid_input",
              "revision_conflict",
              "unavailable"
            ]
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "RegistryContact": {
        "type": "object",
        "required": [
          "registration_number",
          "name",
          "vat_number",
          "billing_address"
        ],
        "properties": {
          "registration_number": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "vat_number": {
            "type": "string"
          },
          "billing_address": {
            "$ref": "#/components/schemas/Address"
          }
        }
      }
    },
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-faktura_session",
        "description": "Production cookie; development uses faktura_session. 12h absolute lifetime."
      }
    }
  }
}
