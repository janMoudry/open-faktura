  },
  "components": {
    "schemas": {
      "Credentials": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "maxLength": 1024
          }
        }
      },
      "Bootstrap": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "secret",
          "email",
          "password"
        ],
        "properties": {
          "secret": {
            "type": "string",
            "minLength": 32,
            "maxLength": 512
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 1024
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "email",
          "installation_admin",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "installation_admin": {
            "type": "boolean"
          },
          "name": {
            "type": "string",
            "maxLength": 120
          }
        }
      },
      "Setup": {
        "type": "object",
        "required": [
          "setup_required"
        ],
        "properties": {
          "setup_required": {
            "type": "boolean"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "invalid_input",
              "unauthorized",
              "already_configured",
              "rate_limited",
              "unavailable",
              "email_taken",
              "invalid_password",
              "conflict"
            ]
          }
        }
      },
      "AccountUpdate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "email"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "current_password": {
            "type": "string",
            "maxLength": 1024
          },
          "new_password": {
            "type": "string",
            "nullable": true,
            "minLength": 12,
            "maxLength": 1024
          }
        }
      }
    },
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-faktura_session",
        "description": "Production cookie; development uses faktura_session. 12h absolute lifetime."
      }
    }
  }
}
