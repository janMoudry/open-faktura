  "components": {
    "schemas": {
      "Address": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "street",
          "city",
          "postal_code",
          "country"
        ],
        "properties": {
          "street": {
            "type": "string",
            "maxLength": 200
          },
          "city": {
            "type": "string",
            "maxLength": 120
          },
          "postal_code": {
            "type": "string",
            "maxLength": 30
          },
          "country": {
            "type": "string",
            "maxLength": 2
          }
        }
      },
      "DeliveryAddress": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "address"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64
          },
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "address": {
            "$ref": "#/components/schemas/Address"
          }
        }
      },
      "Person": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "email",
          "phone"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "maxLength": 254
          },
          "phone": {
            "type": "string",
            "maxLength": 50
          }
        }
      },
      "ContactData": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "registration_number",
          "vat_number",
          "billing_address",
          "delivery_addresses",
          "default_delivery_id",
          "email",
          "phone",
          "persons",
          "recipients",
          "maturity_days",
          "payment_method",
          "bank_account",
          "iban",
          "note"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "registration_number": {
            "type": "string",
            "maxLength": 32
          },
          "vat_number": {
            "type": "string",
            "maxLength": 32
          },
          "billing_address": {
            "$ref": "#/components/schemas/Address"
          },
          "delivery_addresses": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/DeliveryAddress"
            }
          },
          "default_delivery_id": {
            "type": "string",
            "maxLength": 64,
            "nullable": true
          },
          "email": {
            "type": "string",
            "maxLength": 254
          },
          "phone": {
            "type": "string",
            "maxLength": 50
          },
          "persons": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/Person"
            }
          },
          "recipients": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "maxLength": 254
            }
          },
          "maturity_days": {
            "type": "integer",
            "minimum": 0,
            "maximum": 365,
            "nullable": true
          },
          "payment_method": {
            "type": "string",
            "enum": [
              "",
              "cash",
              "bank_transfer"
            ]
          },
          "bank_account": {
            "type": "string",
            "maxLength": 80
          },
          "iban": {
            "type": "string",
            "maxLength": 34
          },
          "note": {
            "type": "string",
            "maxLength": 2000
          }
        }
      },
      "Contact": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "company_id",
          "revision",
          "archived",
          "data"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 200
          },
          "company_id": {
            "type": "string",
            "maxLength": 200
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "archived": {
            "type": "boolean"
          },
          "data": {
            "$ref": "#/components/schemas/ContactData"
          }
        }
      },
      "ContactPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "total",
          "page",
          "page_size"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Contact"
            }
          },
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "page_size": {
            "type": "integer"
          }
        }
      },
      "CreateContact": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "data"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "data": {
            "$ref": "#/components/schemas/ContactData"
          }
        }
      },
      "UpdateContact": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision",
          "archived",
          "data"
        ],
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "archived": {
            "type": "boolean"
          },
          "data": {
            "$ref": "#/components/schemas/ContactData"
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "unauthorized",
              "not_found",
              "forbidden",
              "invalid_input",
              "revision_conflict",
              "unavailable"
            ]
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "RegistryContact": {
        "type": "object",
        "required": [
          "registration_number",
          "name",
          "vat_number",
          "billing_address"
        ],
        "properties": {
          "registration_number": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "vat_number": {
            "type": "string"
          },
          "billing_address": {
            "$ref": "#/components/schemas/Address"
          }
        }
      },
      "InvoiceLine": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "unit",
          "quantity",
          "unit_price",
          "discount_percent",
          "vat_percent"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "unit": {
            "type": "string",
            "maxLength": 30
          },
          "quantity": {
            "type": "string",
            "maxLength": 24,
            "pattern": "^[0-9]+(?:\\.[0-9]{1,4})?$"
          },
          "unit_price": {
            "type": "string",
            "maxLength": 24,
            "pattern": "^[0-9]+(?:\\.[0-9]{1,4})?$"
          },
          "discount_percent": {
            "type": "string",
            "maxLength": 24,
            "pattern": "^[0-9]+(?:\\.[0-9]{1,2})?$"
          },
          "vat_percent": {
            "type": "string",
            "enum": [
              "0",
              "12",
              "21"
            ]
          },
          "catalog_id": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "InvoiceCalculation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "calculation_version",
          "currency",
          "tax_mode",
          "price_mode",
          "discount_percent",
          "rounding",
          "lines"
        ],
        "properties": {
          "calculation_version": {
            "type": "string",
            "enum": [
              "of-czk-v1"
            ]
          },
          "currency": {
            "type": "string",
            "enum": [
              "CZK"
            ]
          },
          "tax_mode": {
            "type": "string",
            "enum": [
              "non_payer",
              "vat_payer"
            ]
          },
          "price_mode": {
            "type": "string",
            "enum": [
              "net",
              "gross"
            ]
          },
          "discount_percent": {
            "type": "string",
            "maxLength": 24,
            "pattern": "^[0-9]+(?:\\.[0-9]{1,2})?$"
          },
          "rounding": {
            "type": "string",
            "enum": [
              "none",
              "whole_czk"
            ]
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InvoiceLine"
            },
            "maxItems": 500
          }
        }
      },
      "InvoiceAmounts": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "net",
          "vat",
          "gross"
        ],
        "properties": {
          "net": {
            "type": "string"
          },
          "vat": {
            "type": "string"
          },
          "gross": {
            "type": "string"
          }
        }
      },
      "InvoiceLineResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "amounts"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "amounts": {
            "$ref": "#/components/schemas/InvoiceAmounts"
          }
        }
      },
      "InvoiceTaxSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tax_mode",
          "vat_percent",
          "amounts"
        ],
        "properties": {
          "tax_mode": {
            "type": "string",
            "enum": [
              "non_payer",
              "vat_payer"
            ]
          },
          "vat_percent": {
            "type": "string",
            "enum": [
              "0",
              "12",
              "21"
            ]
          },
          "amounts": {
            "$ref": "#/components/schemas/InvoiceAmounts"
          }
        }
      },
      "InvoiceTotals": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "calculation_version",
          "currency",
          "lines",
          "tax_summary",
          "amounts",
          "rounding",
          "payable"
        ],
        "properties": {
          "calculation_version": {
            "type": "string",
            "enum": [
              "of-czk-v1",
              "import-v1"
            ]
          },
          "currency": {
            "type": "string",
            "enum": [
              "CZK"
            ]
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InvoiceLineResult"
            }
          },
          "tax_summary": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InvoiceTaxSummary"
            }
          },
          "amounts": {
            "$ref": "#/components/schemas/InvoiceAmounts"
          },
          "rounding": {
            "type": "string"
          },
          "payable": {
            "type": "string"
          }
        }
      },
      "InvoiceError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "fields"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "DraftAddress": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "street",
          "city",
          "postal_code",
          "country"
        ],
        "properties": {
          "street": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "postal_code": {
            "type": "string"
          },
          "country": {
            "type": "string"
          }
        }
      },
      "PartySnapshot": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "registration_number",
          "vat_number",
          "email",
          "phone",
          "address"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "registration_number": {
            "type": "string"
          },
          "vat_number": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "address": {
            "$ref": "#/components/schemas/DraftAddress"
          }
        }
      },
      "PaymentSnapshot": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bank_account",
          "iban",
          "variable_symbol",
          "method"
        ],
        "properties": {
          "bank_account": {
            "type": "string"
          },
          "iban": {
            "type": "string"
          },
          "variable_symbol": {
            "type": "string"
          },
          "method": {
            "type": "string",
            "enum": [
              "cash",
              "bank_transfer"
            ]
          }
        }
      },
      "DraftData": {
        "type": "object",
