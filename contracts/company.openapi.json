  "components": {
    "schemas": {
      "Settings": {
        "type": "object",
        "required": [
          "name",
          "entity_type",
          "registration_number",
          "vat_number",
          "street",
          "city",
          "postal_code",
          "country",
          "email",
          "phone",
          "tax_mode",
          "tax_effective_from",
          "currency",
          "timezone",
          "payment_method",
          "iban",
          "number_prefix",
          "maturity_days",
          "number_year",
          "next_number"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "entity_type": {
            "type": "string",
            "enum": [
              "individual",
              "business"
            ]
          },
          "registration_number": {
            "type": "string"
          },
          "vat_number": {
            "type": "string"
          },
          "street": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "postal_code": {
            "type": "string"
          },
          "country": {
            "type": "string",
            "enum": [
              "CZ"
            ]
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "tax_mode": {
            "type": "string",
            "enum": [
              "non_payer",
              "vat_payer"
            ]
          },
          "tax_effective_from": {
            "type": "string"
          },
          "currency": {
            "type": "string",
            "enum": [
              "CZK"
            ]
          },
          "timezone": {
            "type": "string"
          },
          "payment_method": {
            "type": "string",
            "enum": [
              "cash",
              "bank_transfer"
            ]
          },
          "iban": {
            "type": "string"
          },
          "number_prefix": {
            "type": "string"
          },
          "maturity_days": {
            "type": "integer",
            "minimum": 0,
            "maximum": 365
          },
          "number_year": {
            "type": "integer",
            "minimum": 2000,
            "maximum": 9999
          },
          "next_number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          }
        }
      },
      "TaxProfile": {
        "type": "object",
        "required": [
          "mode",
          "effective_from",
          "revision"
        ],
        "additionalProperties": false,
        "properties": {
          "mode": {
            "type": "string"
          },
          "effective_from": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          }
        }
      },
      "Company": {
        "type": "object",
        "required": [
          "id",
          "revision",
          "step",
          "completed",
          "role",
          "settings",
          "tax_history",
          "missing_fields",
          "number_preview",
          "can_issue"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "step": {
            "type": "integer"
          },
          "completed": {
            "type": "boolean"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "editor",
              "viewer"
            ]
          },
          "settings": {
            "$ref": "#/components/schemas/Settings"
          },
          "tax_history": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaxProfile"
            }
          },
          "missing_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "number_preview": {
            "type": "string"
          },
          "can_issue": {
            "type": "boolean"
          }
        }
      },
      "Create": {
        "type": "object",
        "required": [
          "request_id",
          "settings"
        ],
        "additionalProperties": false,
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "settings": {
            "$ref": "#/components/schemas/Settings"
          }
        }
      },
      "Update": {
        "type": "object",
        "required": [
          "revision",
          "step",
          "complete",
          "settings"
        ],
        "additionalProperties": false,
        "properties": {
          "revision": {
            "type": "integer"
          },
          "step": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "complete": {
            "type": "boolean"
          },
          "settings": {
            "$ref": "#/components/schemas/Settings"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "code"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "faktura_session",
        "description": "Production uses __Host-faktura_session"
      }
    }
  }
}
