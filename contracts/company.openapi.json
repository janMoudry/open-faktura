{
  "openapi": "3.1.0",
  "info": {
    "title": "Open Faktura companies P03",
    "version": "0.1.0",
    "description": "Authenticated company context. No installation-admin bypass. Settings are drafts until complete; can_issue remains false until invoicing is implemented. Changes require revision; creation request_id is idempotent per user."
  },
