[
  {
    "name": "invoice_history",
    "inputSchema": {
      "type": "object",
      "properties": {
        "company_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "default": 1
        }
      },
      "required": [
        "company_id",
        "id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "invoice_send",
    "inputSchema": {
      "type": "object",
      "properties": {
        "company_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "format": "int64"
        },
        "recipient": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "attachment_ids": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "company_id",
        "id",
        "request_id",
        "revision",
        "recipient",
        "subject",
        "body"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "invoice_deliverypdf",
    "inputSchema": {
      "type": "object",
      "properties": {
        "company_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "delivery": {
          "type": "string"
        }
      },
      "required": [
        "company_id",
        "id",
        "delivery"
      ],
      "additionalProperties": false
    }
  }
]
