{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Faktura",
  "version": "0.1.0",
  "identifier": "cz.openfaktura.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @open-faktura/web dev",
    "beforeBuildCommand": "pnpm --filter @open-faktura/web build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Open Faktura",
        "width": 1100,
        "height": 780,
        "minWidth": 360,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' http://127.0.0.1:3001"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
