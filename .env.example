DATABASE_URL=postgres://faktura:faktura@127.0.0.1:54329/faktura
API_ADDRESS=127.0.0.1:3001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,tauri://localhost,http://tauri.localhost
# Optional frontend build override (public, never a secret):
# VITE_API_URL=http://127.0.0.1:3001

APP_ENV=development
# Generate with: node scripts/init-secrets.mjs
BOOTSTRAP_SECRET_FILE=.secrets/bootstrap

# Optional invoice and quotation email delivery (backend only; restart after changing):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_FROM=fakturace@example.com
# SMTP_USERNAME=fakturace@example.com
# SMTP_PASSWORD_FILE=.secrets/smtp-password

# Public web URL for quotation links (HTTPS in deployment; local preview only):
# PUBLIC_WEB_URL=http://127.0.0.1:5173

# UI-managed SMTP passwords require this private 32-byte hex key (init-secrets).
SMTP_ENCRYPTION_KEY_FILE=.secrets/smtp-key
